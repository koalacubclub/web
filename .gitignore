# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# `dist` above is a bare pattern, so it also matches the 3D package's output.
# Those .glb files are generated but deliberately committed — building them in
# CI would mean installing Blender on every runner. See 3d/README.md.
!3d/dist/

# Python bytecode from the Blender asset generators
__pycache__/
*.pyc

# Test / coverage artifacts
coverage
playwright-report
test-results
/blob-report
/playwright/.cache
.artifacts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*
